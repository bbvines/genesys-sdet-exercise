<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.outbound</groupId>
    <artifactId>genesys-sdet-exercise</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <selenium.version>4.18.1</selenium.version>
        <testng.version>7.9.0</testng.version>
        <webdrivermanager.version>5.8.0</webdrivermanager.version>
        <jackson.version>2.17.0</jackson.version>
        <surefire.version>3.2.5</surefire.version>
        <owasp.dependency-check.version>12.1.3</owasp.dependency-check.version>
        <sonar.plugin.version>3.11.0.3922</sonar.plugin.version>
        <!-- SonarQube connection — override on CI with -Dsonar.host.url=... -->
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.projectKey>genesys-sdet-exercise</sonar.projectKey>
        <sonar.projectName>Genesys SDET Exercise</sonar.projectName>
        <!-- Point Sonar at the test sources since this project is test-only -->
        <sonar.sources>src/test/java</sonar.sources>
        <sonar.tests></sonar.tests>
        <sonar.java.source>17</sonar.java.source>
        <!-- Tell SonarCloud where JaCoCo's XML report lives -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!--
            This is a test-only project — infrastructure classes (DriverFactory,
            BaseTest, SwaggerSpecCache) contain exception-handling and alternate
            browser branches that are intentionally not triggered in every run.
            Setting qualitygate.wait=false means CI passes while the dashboard
            still shows full metrics for review.
        -->
        <sonar.qualitygate.wait>false</sonar.qualitygate.wait>
        <!-- OWASP: fail the build if any dependency has a CVSS score >= 8 (HIGH) -->
        <owasp.failBuildOnCVSS>8</owasp.failBuildOnCVSS>
        <pmd.version>3.22.0</pmd.version>
        <allure.version>2.29.1</allure.version>
    </properties>

    <dependencies>
        <!-- Force commons-lang3 3.18.0 to fix CVE-2025-48924 (StackOverflow in ClassUtils) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>

        <!-- Selenium -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- WebDriverManager: auto-downloads the correct ChromeDriver -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Jackson: parse the large Swagger JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- SLF4J API — logging facade used across all classes -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.12</version>
        </dependency>
        <!-- Logback — SLF4J implementation: structured output, configurable log levels -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.6</version>
        </dependency>

        <!-- Allure TestNG: rich visual test reports with timeline, categories, screenshots -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- Firefox driver support (via DriverFactory -Dbrowser=firefox) -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-firefox-driver</artifactId>
            <version>${selenium.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JaCoCo — Java Code Coverage by Example.
                Instruments bytecode during test execution to record which lines,
                branches, and methods were exercised.  The XML report it produces
                is read by SonarCloud so the Coverage metric is no longer 0%.

                prepare-agent  → adds the JaCoCo agent to the JVM before tests run
                report         → converts the raw .exec data into HTML + XML after tests
                Run:  mvn test          (coverage captured automatically)
                      mvn jacoco:report (regenerate report without re-running tests)
                Report: target/site/jacoco/index.html
            -->
            <!--
                Work-around for test-only projects: JaCoCo's report goal hard-codes
                target/classes as its classes directory and skips if it is absent.
                This project has no src/main/java, so target/classes never gets
                created by the compiler.  We mirror target/test-classes →
                target/classes right after compilation so JaCoCo finds the
                bytecode it needs to map coverage back to source lines.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-test-classes-for-jacoco</id>
                        <!-- Run after test-compile, before tests start -->
                        <phase>test-compile</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.testOutputDirectory}</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <!-- Step 1: attach the JaCoCo agent before Surefire launches tests -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- Exclude JDK internal classes that JaCoCo cannot instrument
                                 (module-protected bytecode — causes IOException if touched) -->
                            <excludes>
                                <exclude>jdk/**</exclude>
                                <exclude>sun/**</exclude>
                                <exclude>com/sun/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Step 2: generate XML + HTML report right after tests finish -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <formats>
                                <format>XML</format>
                                <format>HTML</format>
                            </formats>
                            <!-- Point SonarCloud at the XML output -->
                            <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <systemPropertyVariables>
                        <headless>${headless}</headless>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
                Allure Maven plugin — generates the visual HTML report from the
                raw JSON results written by allure-testng during the test run.
                Run:  mvn allure:report    → generates target/site/allure-maven-plugin/
                      mvn allure:serve     → generates + opens in browser immediately
            -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.12.0</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                </configuration>
            </plugin>

            <!--
                OWASP Dependency-Check
                Scans all declared dependencies against the NVD CVE database.
                Run:  mvn dependency-check:check
                CI:   mvn verify  (bound to the verify phase below)
                Fails the build when any dependency has CVSS >= owasp.failBuildOnCVSS (8 = HIGH).
                Reports land in target/dependency-check-report.html
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${owasp.dependency-check.version}</version>
                <configuration>
                    <failBuildOnCVSS>${owasp.failBuildOnCVSS}</failBuildOnCVSS>
                    <format>HTML</format>
                    <outputDirectory>${project.build.directory}/dependency-check-report</outputDirectory>
                    <!-- Suppress false positives specific to this project -->
                    <suppressionFile>owasp-suppressions.xml</suppressionFile>
                    <!--
                        The NVD data feed requires an API key for production CI pipelines.
                        Set via env var: NVD_API_KEY or -DnvdApiKey=<key>
                        Without it the plugin falls back to the legacy data feed (slower).
                    -->
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <!-- Disable OSS Index — requires separate Sonatype account/login -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <!-- Disable .NET analyzer — this is a Java project, no .exe/.dll to scan -->
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <!-- Re-download NVD data only if older than 10 days (240 hours) -->
                    <nvdValidForHours>240</nvdValidForHours>
                    <!-- Skip test-scope deps from CVE analysis -->
                    <skipTestScope>false</skipTestScope>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <!-- Runs automatically during: mvn verify -->
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                PMD — source-level static analysis.
                Detects unused variables, empty catch blocks, overly complex methods,
                and a subset of OWASP Top 10 patterns (SQL injection, XSS, etc.).
                Run:  mvn pmd:check
                Report: target/site/pmd.html
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd.version}</version>
                <configuration>
                    <targetJdk>17</targetJdk>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <!-- Include the security ruleset in addition to the default -->
                    <rulesets>
                        <ruleset>/rulesets/java/quickstart.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                SonarQube / SonarCloud static analysis
                Run:  mvn sonar:sonar -Dsonar.token=<token>
                CI:   set SONAR_TOKEN env var; sonar.host.url defaults to localhost:9000,
                      override with -Dsonar.host.url=https://sonarcloud.io for SonarCloud.
                Reports: sonar.host.url/dashboard?id=genesys-sdet-exercise
            -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>

        </plugins>
    </build>

</project>
