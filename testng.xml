<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Genesys SDET Exercise" verbose="2" parallel="false">

    <listeners>
        <listener class-name="com.outbound.listeners.ScreenshotListener"/>
        <listener class-name="com.outbound.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Scenario 2 - API: Swagger Validation" preserve-order="true">
        <classes>
            <class name="com.outbound.tests.api.SwaggerApiTest"/>
        </classes>
    </test>

    <test name="Scenario 1 - UI: Developer Center Navigation" preserve-order="true">
        <classes>
            <class name="com.outbound.tests.ui.DeveloperCenterUITest"/>
        </classes>
    </test>

</suite>